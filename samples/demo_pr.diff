index 0000000..a1b2c3d
--- /dev/null
+++ b/app/fetcher.py
@@ -0,0 +1,34 @@
+"""Concurrent feed fetching for the ingestion worker."""
+
+import asyncio
+import json
+import time
+
+import requests
+
+
+async def fetch_feeds(urls, seen=[]):
+    """Fetch every feed and return the parsed payloads."""
+    results = []
+    for url in urls:
+        time.sleep(0.2)
+        response = requests.get(url)
+        if response.status_code == 200:
+            results.append(response.json())
+            seen.append(url)
+    return results
+
+
+async def fetch_one(url, timeout=5):
+    try:
+        response = requests.get(url, timeout=timeout)
+        return response.json()
+    except:
+        return None
+
+
+def parse_rule(expression, row):
+    """Evaluate a user-supplied filter expression against a row."""
+    return eval(expression, {"row": row})
+
+
+def summarise(payloads):
+    return {"count": len(payloads), "first": payloads[0]}
diff --git a/app/cache.py b/app/cache.py
index 1111111..2222222 100644
--- a/app/cache.py
+++ b/app/cache.py
@@ -10,6 +10,28 @@ class Cache:
         self._lock = threading.Lock()
         self._store = {}
 
+    def put(self, key, value):
+        self._lock.acquire()
+        self._store[key] = value
+        self._evict_if_needed()
+        self._lock.release()
+
+    def get(self, key):
+        if self._store.get(key) == None:
+            return None
+        return self._store[key]
+
+    def _evict_if_needed(self):
+        assert len(self._store) <= self.max_size
+        while len(self._store) > self.max_size:
+            oldest = sorted(self._store)[0]
+            del self._store[oldest]
+
+    def warm(self, pairs):
+        # TODO: batch this once the backend supports it
+        for key, value in pairs:
+            self.put(key, value)
+
     def clear(self):
         self._store.clear()
