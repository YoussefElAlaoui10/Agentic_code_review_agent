@@ -4,6 +4,19 @@ import subprocess
 
 
 class Exporter:
+    def export_csv(self, rows, path):
+        handle = open(path, "w")
+        for row in rows:
+            handle.write(",".join(str(c) for c in row) + "\n")
+        handle.close()
+        print("exported", len(rows), "rows")
+
+    def archive(self, path, destination):
+        command = "tar czf " + destination + " " + path
+        subprocess.run(command, shell=True)
+
     def export_json(self, rows, path):
         with open(path, "w") as fh:
             json.dump(rows, fh)
