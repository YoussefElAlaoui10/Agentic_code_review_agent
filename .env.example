# Copy to .env and source it, or export these directly.

# The module's 7 provided endpoints (round-robined across parallel reviewers).
# PRREVIEW_ENDPOINTS="http://ep1:8000,http://ep2:8000,http://ep3:8000,http://ep4:8000,http://ep5:8000,http://ep6:8000,http://ep7:8000"

# Or a single endpoint:
# PRREVIEW_BASE_URL="http://localhost:11434/v1"

# PRREVIEW_MODEL="gemma-4-26b-a4b"
# PRREVIEW_API_KEY=""

# Raises the GitHub rate limit from 60 to 5000 requests/hour; required for private repos.
# GITHUB_TOKEN=""
